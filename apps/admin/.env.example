# admin 이 읽는 환경변수 템플릿.
#
# 이 파일을 `.env.local` 로 복사해 값을 채운다. `.env.local` 은 Git 에 올라가지
# 않는다. Vercel 배포는 이 파일을 쓰지 않고 프로젝트 환경변수를 주입받는다.
#
#   cp apps/admin/.env.example apps/admin/.env.local
#
# 주소는 **origin 까지만** 적고 끝에 `/` 를 붙이지 않는다. `/api/v1` 은 코드가
# 붙인다 (src/api/config.ts).
#
# 셋 다 선택이다. 비우면 그 기능이 "주소 미설정" 으로 표시될 뿐 앱은 돌아간다.

# Backoffice API. admin 의 모든 쓰기가 여기로 간다.
# Cloudtype 임시 배포 (backend docs/DEPLOY_CLOUDTYPE.md):
#   https://port-0-backend-mue6mvu2bebbfe1e.sel3.cloudtype.app
VITE_BACKOFFICE_API_BASE=

# Customer API. admin 은 홈 상태 줄에서 살아있는지 확인하는 데만 쓴다.
# Cloudtype 임시 배포:
#   https://port-0-backendcustomer-mue6mvu2bebbfe1e.sel3.cloudtype.app
VITE_CUSTOMER_API_BASE=

# 이미지 S3 key 앞에 붙일 CloudFront origin (명세 §2.2).
# 비우면 목 이미지로 보여준다.
VITE_ASSET_BASE=
