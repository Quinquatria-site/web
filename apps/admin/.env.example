# admin 이 읽는 환경변수 템플릿.
#
# 이 파일을 `.env.local` 로 복사해 값을 채운다. `.env.local` 은 Git 에 올라가지
# 않는다. Vercel 배포는 이 파일을 쓰지 않고 프로젝트 환경변수를 주입받는다.
#
#   cp apps/admin/.env.example apps/admin/.env.local
#
# 주소는 **origin 까지만** 적고 끝에 `/` 를 붙이지 않는다. `/api/v1` 은 코드가
# 붙인다 (src/api/config.ts).
#
# 셋 다 선택이다. src/api/config.ts 에 배포 주소가 기본값으로 있어서,
# 다른 서버(로컬 백엔드 등)에 붙여볼 때만 여기서 덮어쓴다.

# Backoffice API. admin 의 모든 쓰기가 여기로 간다.
VITE_BACKOFFICE_API_BASE=

# Customer API. admin 은 홈 상태 줄에서 살아있는지 확인하는 데만 쓴다.
VITE_CUSTOMER_API_BASE=

# 이미지 S3 key 앞에 붙일 origin (명세 §2.2).
# 비우면 src/api/config.ts 의 S3 버킷 주소를 쓴다. CloudFront 로 옮길 때만 넣는다.
VITE_ASSET_BASE=

# ── 방문 통계 (api/analytics.ts) ──────────────────────────────────────────
# 서버리스 함수만 읽는 **비밀 값**이다. VITE_ 를 붙이면 번들에 박혀 누구나
# 보게 되니 절대 붙이지 않는다. Vercel admin 프로젝트 환경변수에 넣는다.
# 로컬 `pnpm dev:admin` 은 vite.config.ts 의 devApi 가 `.env.local` 에서 읽는다.

# Cloudflare API 토큰. 권한은 Account > Account Analytics > Read 하나면 된다.
CF_API_TOKEN=

# Cloudflare 계정 ID. 대시보드 주소 dash.cloudflare.com/<여기>/… 의 값.
CF_ACCOUNT_ID=

# Web Analytics 사이트 태그. 학생 앱 비콘 토큰(NEXT_PUBLIC_CF_BEACON_TOKEN)과 다른 값이다.
CF_SITE_TAG=
