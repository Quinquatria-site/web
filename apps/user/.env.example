# `.env.local` 로 복사해 채운다. 배포는 Vercel user 프로젝트 환경변수에 넣는다.

# Customer API origin. 예: https://example.com
# 축제가 끝나 shared/api/snapshot 을 읽으므로 지금은 쓰지 않는다.
# 서버(빌드·재검증)에서만 읽으므로 NEXT_PUBLIC_ 을 붙이지 않는다.
API_BASE_URL=

# 외부 백엔드가 /api/revalidate 를 부를 때 Authorization: Bearer 로 보내는 비밀 키. 백엔드와 같은 값을 쓴다.
# 서버에서만 읽으므로 NEXT_PUBLIC_ 을 붙이지 않는다. Vercel 은 Production · Preview 각각 넣는다.
REVALIDATE_SECRET=

# Cloudflare Web Analytics 토큰. 브라우저로 나가는 공개 값이라 NEXT_PUBLIC_ 을 붙인다.
# Vercel 은 Production 에만 넣는다. 비워 두면 비콘을 싣지 않아 로컬·스테이징 방문이 섞이지 않는다.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# 이미지 S3 key 앞에 붙일 origin. 비우면 shared/photo/asset-url.ts 의 S3 버킷 주소를 쓴다.
# 사진을 public/images 로 옮겨 지금은 쓰지 않는다.
# CloudFront 로 옮길 때만 넣는다. 브라우저 컴포넌트도 읽어 NEXT_PUBLIC_ 이고, 빌드 때 박히니 바꾸면 재배포한다.
NEXT_PUBLIC_ASSET_BASE=

# 공유 카드(og:image·og:url)를 절대 주소로 만들 사이트 origin. 예: https://www.quinquatria.site
# 서버(빌드·재검증)에서만 읽으므로 NEXT_PUBLIC_ 을 붙이지 않는다. Vercel 은 Production · Preview(dev) 각각 넣고, 비우면 배포 주소를 쓴다.
SITE_URL=
